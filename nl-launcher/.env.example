# =============================================================================
# NL Mirror - macOS Code Signing Configuration
# =============================================================================
# Copy file này thành .env và điền thông tin của bạn
#
# Tham khảo: https://tauri.app/distribute/sign/macos/
# =============================================================================

# -----------------------------------------------------------------------------
# SIGNING (Bắt buộc để ký ứng dụng)
# -----------------------------------------------------------------------------

# Signing Identity - Tên certificate trong Keychain
# Chạy lệnh: security find-identity -v -p codesigning
# 
# Có 2 loại certificate:
# - "Apple Development: ..." → Chỉ để test, Gatekeeper vẫn chặn
# - "Developer ID Application: ..." → Phân phối, Gatekeeper cho phép (cần notarize)
#
# Để dùng ad-hoc signing (không cần certificate): APPLE_SIGNING_IDENTITY=-
APPLE_SIGNING_IDENTITY=

# -----------------------------------------------------------------------------
# NOTARIZATION (Bắt buộc khi dùng Developer ID Application)
# -----------------------------------------------------------------------------
# Có 2 cách để notarize: App Store Connect API hoặc Apple ID
# Chọn MỘT trong hai cách dưới đây:

# === CÁCH 1: App Store Connect API (Khuyến nghị cho CI/CD) ===
# 1. Truy cập: https://appstoreconnect.apple.com/access/users
# 2. Tab "Integrations" → Add API Key với "Developer" access
# 3. Download private key (.p8 file)

# APPLE_API_ISSUER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_API_KEY=XXXXXXXXXX
# APPLE_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# === CÁCH 2: Apple ID (Đơn giản hơn cho local) ===
# 1. APPLE_ID: Email đăng ký Apple Developer
# 2. APPLE_PASSWORD: App-Specific Password (KHÔNG phải password Apple ID)
#    Tạo tại: https://appleid.apple.com/account/manage → App-Specific Passwords
# 3. APPLE_TEAM_ID: Team ID (10 ký tự)
#    Xem tại: https://developer.apple.com/account → Membership

APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# -----------------------------------------------------------------------------
# CI/CD (Chỉ cần khi build trên GitHub Actions, etc.)
# -----------------------------------------------------------------------------
# Export certificate từ Keychain dạng .p12, convert sang base64:
#   openssl base64 -in certificate.p12 -out certificate-base64.txt
#
# APPLE_CERTIFICATE=<base64 encoded .p12 file>
# APPLE_CERTIFICATE_PASSWORD=<password khi export .p12>
